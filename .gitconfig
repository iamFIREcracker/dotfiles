[user]
  name = Matteo Landi
  email = matteo@matteolandi.net

[core]
  editor = vim
  attributesfile = ~/.config/git/.gitattributes

[color]
  branch = auto
  diff = auto
  status = auto

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = reverse
  frag = reverse
  old = brightwhite red
  new = brightwhite green

[color "interactive"]
  prompt = reverse

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[alias]
    tags = tag -l
    branches = branch -a
    remotes = remote -v
    stashes = stash list

    b = "!f() { git branch --color --verbose | tr -d '\\r'; }; f"
    bb = "!f() { git branch --color --verbose --verbose | tr -d '\\r'; }; f"
    bd = branch -d

    st = status --short --ignore-submodules=untracked
    ci = commit -v
    cm = commit -v -m
    cmm = commit --no-edit

    sw = switch
    show1p = show --first-parent
    co = checkout
    cob = checkout -b
    com = !git checkout $(git-default-branch)

    mo = !git-merge-origin
    mom = !git-merge-origin $(git-default-branch)

    mr = "!f() { git com && git up && git mo \"${@}\" && git push && git bd \"${@}\"; }; f"

    pretty-log = "!f() { \
        git log \"${@}\" --color=always --date=\"$(git-log-date-format)\" --pretty='tformat:%h%Creset %s (%ad by %an)%d%Creset'; \
    }; f"
    ll = pretty-log
    ll10 = pretty-log -n 10


    graph-log = "!f() { \
        git log \"${@}\" --color=always --graph --date=\"$(git-log-date-format)\" --topo-order --pretty='tformat:%h%Creset %s (%ad by %an)%d%Creset'; \
    }; f"
    gl = graph-log

    up = !git pull --rebase --prune $@ && git submodule update --init --recursive

    pushf = push --force-with-lease
    root = rev-parse --show-toplevel
    currentbranch = !git rev-parse --abbrev-ref HEAD 2>/dev/null

    d  = "!f() { cd ${GIT_PREFIX:-.}; git diff \"${@}\" | vim -c 'set ft=diff' -R -; }; f"

    zip = archive -o latest.zip HEAD

    whatadded = log --diff-filter=A
    whatdeleted = log --diff-filter=D

    fuck-win = "!f() { \
        git config core.preloadindex true; \
        git config core.fscache true; \
        git config core.autocrlf true; \
        git config core.filemode false; \
    }; f"

    find-merge = "!sh -c 'commit=$0 && branch=${1:-HEAD} && (git rev-list $commit..$branch --ancestry-path | cat -n; git rev-list $commit..$branch --first-parent | cat -n) | sort -k2 -s | uniq -f1 -d | sort -n | tail -1 | cut -f2'"
    show-merge = "!sh -c 'merge=$(git find-merge $0 $1) && [ -n \"$merge\" ] && git show $merge'"

    br-summary = "!f() { git log --reverse --pretty='format:### %s%n%n%b' \"${@}\" | vipe | cb; }; f"
    br-stat = "!f() { git diff --stat \"${@}\"; }; f"
    br-files = "!f() { git diff --name-only \"${@}\"; }; f"

    work      = !sh -c 'git fetch && git checkout @{upstream} --track=direct  -b \"$@\"' _
    work-stag = !sh -c '             git checkout             --track=inherit -b \"$@\"' _

[browser "br"]
    cmd = br

[commit]
    verbose = true

[diff]
    ; context = 10
    ; algorith = historgram ; https://jvns.ca/blog/2024/02/16/popular-git-config-options/

[difftool]
    prompt = false
    trustExitCode = true

[fetch]
    prune = true
    prunetags = true

[init]
    defaultBranch = main

[merge]
    tool = fugitive
    conflictstyle = diff3
    ff = only

[mergetool]
    trustExitCode = true
    prompt = false

[mergetool "fugitive"]
    ; https://github.com/tpope/vim-fugitive/issues/1306#issuecomment-1025124663
    cmd = vim -f -c \"Gvdiffsplit!\" \"$MERGED\"

[pull]
    rebase = true

[push]
    default = current

[rebase]
    autosquash = true
    autoStash = true
    instructionFormat = "%s (%ad by %an)"
    updateRefs = true
    rebaseMerges = true

; (re)use (re)corded (re)solution
; https://git-scm.com/book/en/v2/Git-Tools-Rerere
[rerere]
    enabled = true

[web]
    browser = br
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

; [pager]
; 	diff = diff-highlight | less -RFX
; 	show = diff-highlight | less -RFX
; 	log = diff-highlight | less -RFX
;
; [interactive]
; 	diffFilter = diff-highlight
