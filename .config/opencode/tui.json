{
  "$schema": "https://opencode.ai/tui.json",
  "keybinds": {
    "leader": "ctrl+x",
    "session_interrupt": "ctrl+c",
    "command_list": "<leader>:",
    "editor_open": "<leader>ctrl+e",
    "input_move_up": "ctrl+p",
    "input_move_down": "ctrl+n",
    "history_previous": "ctrl+p",
    "history_next": "ctrl+n"
  }
}
