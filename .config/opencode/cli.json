{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "none"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "command.palette.show": "<leader>:",
    "prompt.editor": "<leader>ctrl+e",
    "session.interrupt": "ctrl+c",
    "input.move.up": "ctrl+p",
    "input.move.down": "ctrl+n",
    "prompt.history.previous": "ctrl+p",
    "prompt.history.next": "ctrl+n"
  },
  "attention": {
    "notifications": true,
    "sound": false
  },
  "mini": {
    "mono": true
  },
  "plugins": [
    "~/Workspace/claude-code-scripts/bin/opencode/status-line"
  ]
}

