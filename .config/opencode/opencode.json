                }
              }
            },
            "high": {
              "extra_body": {
                "chat_template_kwargs": {
                  "enable_thinking": true,
                  "thinking_budget": 12000
                }
              }
            },
            "unlimited": {
              "extra_body": {
                "chat_template_kwargs": {
                  "enable_thinking": true,
                  "thinking_budget": 16000
                }
              }
            }
          }
        }
      }
    },
    "catai/litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CAT AI (Litellm)",
      "options": {
        "baseURL": "https://catai-apisix.ikd.1808.aws.iongroup.net/litellm",
        "apiKey": "{env:CATAI_SEALS_API_KEY}"
      },
      "models": {
        "claude-opus-4-6": {
