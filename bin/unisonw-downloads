#!/usr/bin/env bash

set -e

exec > >(tee -a ~/unison-downloads.log) 2>&1
date

case $HOSTNAME in
    beast.local)
        unisonw \
            "$HOME/Downloads" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/Downloads" \
            -perms 0 \
            "$@"
        ;;
    EU-C3GB434-L)
        unisonw \
            "$HOME/Downloads" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/Downloads" \
            -perms 0 \
            "$@"
        ;;
    *)
        unisonw \
            "$HOME/Downloads" \
            "ssh://beast.tailscale.internal//Users/matteolandi/Downloads" \
            -perms 0 \
            "$@"
        ;;
esac
