#!/usr/bin/env bash

set -e

exec > >(tee -a ~/unison-downloads.log) 2>&1
date

# Elsewhere than beast, UNISONW_PEER=skinny selects skinny as the peer (e.g. when
# beast is down).
case $HOSTNAME in
    beast.local)
        unisonw \
            "$HOME/Downloads" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/Downloads" \
            -perms 0 \
            "$@"
        ;;
    *)
        unisonw \
            "$HOME/Downloads" \
            "ssh://${UNISONW_PEER:-beast}.tailscale.internal//Users/matteolandi/Downloads" \
            -perms 0 \
            "$@"
        ;;
esac
