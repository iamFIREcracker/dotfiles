#!/usr/bin/env bash
# Launch fzf with personal default settings.
#
# Binary: Homebrew's, or the local build in ~/Workspace/fzf when
# FZF_USE_LOCAL_BUILD=1 (built on demand; Homebrew's if the build fails).
#
# Settings: placed in FZF_DEFAULT_OPTS ahead of whatever the caller already
# put there, so the caller's settings take precedence over these, and
# command-line arguments take precedence over both.
#
# List colors: the terminal's foreground and background, swapped, so the list
# stands out in light and dark themes alike.  They are read from the terminal
# (OSC 10/11) on every launch, so they follow theme changes.  tmux answers
# these queries for its panes but not for its popups; inside tmux, an
# unanswered query is therefore repeated in a detached window of the current
# session, which shows in the status line while it runs (tens of
# milliseconds).  When no colors can be obtained, the list uses the reverse
# attribute instead, which covers the text of each item but not the rest of
# the line.

repo=~/Workspace/fzf
local_build="$repo/bin/fzf"

fzf_binary="${HOMEBREW_PREFIX:-/opt/homebrew}/bin/fzf"
if [ "${FZF_USE_LOCAL_BUILD:-0}" = "1" ]; then
    if [ ! -x "$local_build" ]; then
        mise exec -- make -C "$repo" bin/fzf 1>&2
    fi
    if [ -x "$local_build" ]; then
        fzf_binary=$local_build
    fi
fi

# Succeed when the arguments ask fzf to draw its interface, as opposed to
# filtering, printing its version, help or shell integration scripts.
interface_requested() {
    local argument
    for argument in "$@"; do
        case $argument in
            -f* | --filter | --filter=* | --version | -h | --help | --man | --bash | --zsh | --fish)
                return 1 ;;
        esac
    done
    return 0
}

# Convert one component of an X11 rgb: color specification (1 to 4 hex
# digits) to two hex digits.  Case is kept: fzf accepts either.
color_component_to_byte() {
    local component=$1
    [ ${#component} -eq 1 ] && component=$component$component
    printf '%s' "${component:0:2}"
}

# Ask the terminal for its foreground and background colors and store them,
# as #rrggbb, in terminal_foreground and terminal_background.  Fails when
# there is no terminal or it does not report both colors.
query_terminal_colors() {
    local saved_settings reply='' character code pattern color
    terminal_foreground=''
    terminal_background=''

    ( : <>/dev/tty ) 2>/dev/null || return 1
    exec 3<>/dev/tty
    saved_settings=$(stty -g <&3) || { exec 3<&-; return 1; }
    trap 'stty "$saved_settings" <&3; exit 129' HUP TERM
    stty raw -echo <&3

    # Every terminal answers the device attributes query (ESC [ c), and it
    # answers after the color queries, so its reply marks the end of the
    # response even when the color queries go unanswered.
    printf '\e]10;?\e\\\e]11;?\e\\\e[c' >&3
    while IFS= read -r -s -n 1 -t 1 -u 3 character; do
        reply+=$character
        [[ $reply == *$'\e[?'*c ]] && break
    done

    stty "$saved_settings" <&3
    trap - HUP TERM
    exec 3<&-

    for code in 10 11; do
        pattern="]$code;rgb:([0-9A-Fa-f]+)/([0-9A-Fa-f]+)/([0-9A-Fa-f]+)"
        [[ $reply =~ $pattern ]] || return 1
        color="#$(color_component_to_byte "${BASH_REMATCH[1]}")$(color_component_to_byte "${BASH_REMATCH[2]}")$(color_component_to_byte "${BASH_REMATCH[3]}")"
        if [ "$code" = 10 ]; then
            terminal_foreground=$color
        else
            terminal_background=$color
        fi
    done
}

# Probe mode, entered when query_colors_through_tmux_window starts this script
# in its detached window: write the colors (or nothing) to the file named by
# FZF_COLOR_PROBE_OUTPUT, then wait to be killed with the window.  Waiting
# rather than exiting keeps the pane from dying, which would fire pane-died
# hooks.  The sleep only bounds the wait should the launching wrapper fail.
if [ -n "${FZF_COLOR_PROBE_OUTPUT:-}" ]; then
    if query_terminal_colors; then
        printf '%s %s\n' "$terminal_foreground" "$terminal_background" >"$FZF_COLOR_PROBE_OUTPUT.partial"
    else
        : >"$FZF_COLOR_PROBE_OUTPUT.partial"
    fi
    mv "$FZF_COLOR_PROBE_OUTPUT.partial" "$FZF_COLOR_PROBE_OUTPUT"
    exec sleep 10
fi

# Run query_terminal_colors in a detached window of the current tmux session,
# whose pane tmux answers the color queries for, and store the colors it
# reports in terminal_foreground and terminal_background.  Fails outside
# tmux, and when the window reports no colors within one second.
query_colors_through_tmux_window() {
    local script_path probe_directory output window_id attempt
    terminal_foreground=''
    terminal_background=''
    [ -n "${TMUX:-}" ] || return 1

    script_path=${BASH_SOURCE[0]}
    case $script_path in
        /*) ;;
        */*) script_path=$PWD/$script_path ;;
        *) script_path=$(command -v -- "$script_path") || return 1 ;;
    esac

    probe_directory=$(mktemp -d "${TMPDIR:-/tmp}/fzf-color-probe.XXXXXX") || return 1
    output=$probe_directory/colors
    if ! window_id=$(tmux new-window -d -P -F '#{window_id}' \
            "FZF_USE_LOCAL_BUILD=0 FZF_COLOR_PROBE_OUTPUT=$(printf %q "$output") exec $(printf %q "$script_path")"); then
        rm -rf "$probe_directory"
        return 1
    fi
    for (( attempt = 0; attempt < 100; attempt++ )); do
        [ -e "$output" ] && break
        sleep 0.01
    done
    tmux kill-window -t "$window_id" 2>/dev/null
    [ -s "$output" ] && read -r terminal_foreground terminal_background <"$output"
    rm -rf "$probe_directory"
    [ -n "$terminal_background" ]
}

input_border_option=''
list_colors='
    list-fg:reverse
    list-bg:reverse
    hl:reverse'
if interface_requested "$@" && { query_terminal_colors || query_colors_through_tmux_window; }; then
    # hl: the list's own colors, so matched characters look like the rest of
    # the item, as with the reverse attribute below.
    # input-border: without an input border fzf draws the prompt row on
    # list-bg, so give the input a left border, drawn in the terminal's
    # background color, to keep the prompt on the terminal's own colors.
    list_colors="
    list-fg:$terminal_background
    list-bg:$terminal_foreground
    hl:$terminal_background
    input-border:$terminal_background"
    input_border_option='--input-border=left'
fi

if [ -z "${FZF_DEFAULT_COMMAND:-}" ]; then
    export FZF_DEFAULT_COMMAND='rg --files --hidden --smart-case --glob "!.git/*"'
fi

# --exact removed to try the emacs-ivy style of matching.
export FZF_DEFAULT_OPTS="
  --sort
  --reverse
  --highlight-line
  --height=~13
  --pointer=
  --marker=
  --scrollbar=
  --info=inline-right
  --no-separator
  $input_border_option
  --color=\"
    bw
    $list_colors
    current-fg:regular:bright-white
    current-bg:regular:bright-magenta
    current-hl:regular:bright-white
    selected-fg:regular:bright-white
    selected-bg:regular:cyan
    prompt:magenta
    input-bg:regular
    query:regular
  \"
  --bind=\"end:accept,ctrl-k:kill-line,ctrl-n:down,ctrl-p:up,ctrl-r:previous-history,alt-r:next-history,alt-a:toggle-all,ctrl-g:become(printf \\\"%s\\n\\\" {} | vipe)\"
${FZF_DEFAULT_OPTS:-}"

exec "$fzf_binary" "$@"
