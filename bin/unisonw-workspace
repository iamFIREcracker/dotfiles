#!/usr/bin/env bash

set -e

exec > >(tee -a ~/unison-workspace.log) 2>&1
date

# Elsewhere than beast, UNISONW_PEER=skinny selects skinny as the peer (e.g. when
# beast is down).
case $HOSTNAME in
    beast.local)
        unisonw \
            "$HOME/Workspace" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/Workspace" \
            -ignore "Name job" \
            -ignore "Name reallythebestgrocerylistappever.com/data/app.db" \
            -ignore "Name fzf/bin/fzf" \
            "$@"
        ;;
    *)
        unisonw \
            "$HOME/Workspace" \
            "ssh://${UNISONW_PEER:-beast}.tailscale.internal//Users/matteolandi/Workspace" \
            -ignore "Name job" \
            -ignore "Name reallythebestgrocerylistappever.com/data/app.db" \
            -ignore "Name fzf/bin/fzf" \
            "$@"
        ;;
esac
