#!/usr/bin/env bash

set -e

exec 2>&1 | tee -a ~/unison-workspace.log
date

case $HOSTNAME in
    beast.local)
        unisonw \
            "$HOME/Workspace" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/Workspace" \
            -ignore "Name job" \
            -ignore "Name reallythebestgrocerylistappever.com/data/app.db" \
            -ignore "Name fzf/bin/fzf" \
            "$@"
        ;;
    EU-C3GB434-L)
        unisonw \
            "$HOME/Workspace" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/Workspace" \
            -ignore "Name job" \
            -ignore "Name reallythebestgrocerylistappever.com/data/app.db" \
            -ignore "Name fzf/bin/fzf" \
            "$@"
        ;;
    *)
        unisonw \
            "$HOME/Workspace" \
            "ssh://beast.tailscale.internal//Users/matteolandi/Workspace" \
            -ignore "Name job" \
            -ignore "Name reallythebestgrocerylistappever.com/data/app.db" \
            -ignore "Name fzf/bin/fzf" \
            "$@"
        ;;
esac
