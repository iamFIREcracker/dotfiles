#!/usr/bin/env bash

set -e

exec > >(tee -a ~/unison-config.log) 2>&1
date

case $HOSTNAME in
    beast.local)
        unisonw \
            "$HOME/.config" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/.config" \
            -ignorenot "Name io.datasette.llm/logs.db" \
            "$@"
        ;;
    EU-C3GB434-L)
        unisonw \
            "$HOME/.config" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/.config" \
            -ignorenot "Name io.datasette.llm/logs.db" \
            "$@"
        ;;
    *)
        unisonw \
            "$HOME/.config" \
            "ssh://beast.tailscale.internal//Users/matteolandi/.config" \
            -ignorenot "Name io.datasette.llm/logs.db" \
            "$@"
        ;;
esac
