#!/bin/bash
# Merge two bash history files into a third: the union of their entries,
# ordered by timestamp.  An entry is a `#<epoch>` line (written because
# HISTTIMEFORMAT is set) plus the command line(s) under it; each line before
# the first timestamp is an entry of its own, with timestamp 0.  An entry
# occurring n times in one file and m in the other occurs max(n, m) times in
# the result, so the history both files share appears once, and repeated
# commands are kept.  Used by unisonw-config as the -merge program for
# ~/.config/bash/history/*, so that commands added on both machines between
# two synchronizations all survive.
set -euo pipefail
in1=${1?Need a first history file}
in2=${2?Need a second history file}
out=${3?Need an output file}
awk '
    function flush(   key) {
        if (entry != "") {
            key = entry "\002" ++occurrences[entry]
            if (!(key in seen)) {
                seen[key] = 1
                printf "%d\t%d\t%s\n", stamp, ++sequence, entry
            }
        }
        entry = ""
    }
    FNR == 1          { flush(); stamp = 0; stamped = 0; delete occurrences }
    /^#[0-9]+$/       { flush(); stamp = substr($0, 2); stamped = 1; entry = $0; next }
    !stamped          { flush(); entry = $0; next }
                      { entry = entry "\001" $0 }
    END               { flush() }
' "$in1" "$in2" |
    sort -t $'\t' -k1,1n -k2,2n |
    cut -f3- |
    tr '\001' '\n' > "$out"
