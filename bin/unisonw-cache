#!/usr/bin/env bash

set -e

exec > >(tee -a ~/unison-cache.log) 2>&1
date

case $HOSTNAME in
    beast.local)
        unisonw \
            "$HOME/.cache" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/.cache" \
            -path "huggingface" \
            -path "ollama" \
            -path "llama.cpp" \
            -path "quicklisp" \
            -path "qmd" \
            "$@"
        ;;
    EU-C3GB434-L)
        unisonw \
            "$HOME/.cache" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/.cache" \
            -path "huggingface" \
            -path "ollama" \
            -path "llama.cpp" \
            -path "quicklisp" \
            -path "qmd" \
            "$@"
        ;;
    *)
        unisonw \
            "$HOME/.cache" \
            "ssh://beast.tailscale.internal//Users/matteolandi/.cache" \
            -path "huggingface" \
            -path "ollama" \
            -path "llama.cpp" \
            -path "quicklisp" \
            -path "qmd" \
            "$@"
        ;;
esac
