#!/usr/bin/env bash

set -e

exec > >(tee -a ~/unison-plan.log) 2>&1
date

# Elsewhere than beast, UNISONW_PEER=skinny selects skinny as the peer (e.g. when
# beast is down).
case $HOSTNAME in
    beast.local)
        unisonw \
            "$HOME/plan" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/plan" \
            "$@"
        unisonw \
            "$HOME/plan" \
            "$HOME/Dropbox/plan" \
            "$@"
        ;;
    *)
        unisonw \
            "$HOME/plan" \
            "ssh://${UNISONW_PEER:-beast}.tailscale.internal//Users/matteolandi/plan" \
            "$@"
        unisonw \
            "$HOME/plan" \
            "ssh://${UNISONW_PEER:-beast}.tailscale.internal//Users/matteolandi/Dropbox/plan" \
            "$@"
        ;;
esac
