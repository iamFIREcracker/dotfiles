#!/usr/bin/env bash

set -e

exec > >(tee -a ~/unison-plan.log) 2>&1
date

case $HOSTNAME in
    beast.local)
        unisonw \
            "$HOME/plan" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/plan" \
            "$@"
        unisonw \
            "$HOME/plan" \
            "$HOME/Dropbox/plan" \
            "$@"
        ;;
    EU-C3GB434-L)
        unisonw \
            "$HOME/plan" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/plan" \
            "$@"
        unisonw \
            "$HOME/plan" \
            "ssh://skinny.tailscale.internal//Users/matteolandi/Dropbox/plan" \
            "$@"
        ;;
    *)
        unisonw \
            "$HOME/plan" \
            "ssh://beast.tailscale.internal//Users/matteolandi/plan" \
            "$@"
        unisonw \
            "$HOME/plan" \
            "ssh://beast.tailscale.internal//Users/matteolandi/Dropbox/plan" \
            "$@"
        ;;
esac
