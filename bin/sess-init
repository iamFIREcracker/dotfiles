#!/usr/bin/env bash

set -xe

# TA_GROUP is ta's ONE-SHOT override: it beats LC_TA_GROUP and session stamps on
# every invocation, and set-but-empty means "leave group". If the login
# environment happens to carry it, every child booted below (the tmuxinator tmux
# server, and the alacritty terminals via start-terminal) would inherit it
# permanently and drag regrouped sessions back. Scrub it once, here, so the whole
# boot path below sees only the sticky LC_TA_GROUP.
unset TA_GROUP

if [ -f "${TMP}/started.lock" ]; then
    exit 0
fi

~/bin/local-services
if [ $HOSTNAME == "beast.local" ]; then
    # (cd ~/Workspace/local-proxy; tmuxinator start --no-attach)
    # (cd ~/Workspace/nix-cache-proxy; tmuxinator start --no-attach)
    tmuxinator start --no-attach ollama
fi

if [ $HOSTNAME == "EU-C3GB434-L" ]; then
    cmd.exe /c "$(wslpath -w ~/my-env/Windows/AutoHotkey/KeyMappings.ahk)" > /dev/null 2>&1 &
    disown
fi

LC_TA_GROUP=main ~/bin/start-terminal editor
sleep 0.5
LC_TA_GROUP=main ~/bin/start-terminal llm
sleep 0.5
LC_TA_GROUP=main ~/bin/start-terminal start
sleep 0.5
LC_TA_GROUP=main ~/bin/start-terminal terminal
sleep 0.5
LC_TA_GROUP=off ~/bin/start-terminal plan
sleep 0.5

date > "${TMP}/started.lock"
exit 0
