# Enable bracketed-paste: https://cirw.in/blog/bracketed-paste
set enable-bracketed-paste on

# Stop, please
set bell-style none

# Enable vi editing mode
# set editing-mode vi
# Customize PS1 depending on mode (insert, command)
# $if Bash
#     set show-mode-in-prompt on
#     # set vi-ins-mode-string "\1\e[1;96m\2+\1\e[0m\2"
#     set vi-ins-mode-string "+"
#     set vi-cmd-mode-string ":"
# $endif

# Display matches for ambiguous patterns at first tab press
set show-all-if-ambiguous on
# Allows space to complete and expand !$ eg:
# $ ls Projects
# $ cd !$<space> # completes to `cd Projects`
# 2017-10-21: setting this somehow fucks up rlwrap, so I had to disable it
# Space:magic-space

# Invoke $EDITOR while inside a rlwrap'd command
$if ccl
  "\C-x\C-e": rlwrap-call-editor
$endif
$if chez
  "\C-x\C-e": rlwrap-call-editor
$endif
$if node-repl
  "\C-x\C-e": rlwrap-call-editor
  # https://stackoverflow.com/questions/21863836/using-rlwrap-with-node-js-repl-how-could-node-break-ctrl-c-not-be-interpre/21975508#21975508
  "\C-c": rlwrap-direct-keypress
$endif
$if node
  "\C-x\C-e": rlwrap-call-editor
  # https://stackoverflow.com/questions/21863836/using-rlwrap-with-node-js-repl-how-could-node-break-ctrl-c-not-be-interpre/21975508#21975508
  "\C-c": rlwrap-direct-keypress
$endif
$if racket
  "\C-x\C-e": rlwrap-call-editor
$endif
$if python
  "\C-x\C-e": rlwrap-call-editor
$endif
$if sbcl
  "\C-x\C-e": rlwrap-call-editor
$endif
$if llm
  "\C-x\C-e": rlwrap-call-editor
$endif
$if guile
  "\C-x\C-e": rlwrap-call-editor
$endif

# Reload this file
"\C-xr": re-read-init-file
# Pipe last command to cg with C-Enter -- my terminal generates ◊ on C-Enter
# - `x`: adds a dummy char to make sure the prompt is non empty
#   (https://unix.stackexchange.com/questions/509035/clear-the-kill-ring-in-bash-or-kill-an-empty-string-with-ctrl-k#comment1101115_509035)
# - `\C-u`: cuts the existing prompt
# - ` !-1 2>&1 ...` the command we want to run. Note: the leading space is
#   intentional, as it prevents the command from being added to bash history
# - `\C-m`: runs the command, as if the user had pressed Enter
# - `\C-y`: yanks the original prompt back in
# - `\C-h`: deletes the dummy character added at the beginning
"◊": "x\C-u !-1 2>&1 | strip-escapes | cg-fzf\C-m\C-y\C-h"
# Resume suspended program with C-Z
# - `x`: adds a dummy char to make sure the prompt is non empty
#   (https://unix.stackexchange.com/questions/509035/clear-the-kill-ring-in-bash-or-kill-an-empty-string-with-ctrl-k#comment1101115_509035)
# - `\C-u`: cuts the existing prompt
# - ` fg` the command we want to run. Note: the leading space is intentional,
#   as it prevents the command from being added to bash history
# - `\C-m`: runs the command, as if the user had pressed Enter
# - `\C-y`: yanks the original prompt back in
# - `\C-h`: deletes the dummy character added at the beginning
"\C-z": "x\C-u fg\C-m\C-y\C-h"
# Nicer clear screen:
# - `x`: adds a dummy char to make sure the prompt is non empty
#   (https://unix.stackexchange.com/questions/509035/clear-the-kill-ring-in-bash-or-kill-an-empty-string-with-ctrl-k#comment1101115_509035)
# - `\C-u`: cuts the existing prompt
# - ` clear-screen-and-position-cursor-at-the-bottom` the command we want to
#   run. Note: the leading space is intentional, as it prevents the command
#   from being added to bash history
# - `\C-m`: runs the command, as if the user had pressed Enter
# - `\C-y`: yanks the original prompt back in
# - `\C-h`: deletes the dummy character added at the beginning
"\C-l": "x\C-u clear-screen-and-position-cursor-at-the-bottom\C-m\C-y\C-h"

# Keymaps for when we're in command mode (e.g., after hitting ESC)
# set keymap vi-command
# "gg": beginning-of-history
# "G": end-of-history
# "H": beginning-of-line
# "L": end-of-line

# set keymap vi-insert
# "\C-l": "clear-screen-and-position-cursor-at-the-bottom"
