" DiffHistory
" https://github.com/tpope/vim-fugitive/issues/132#issuecomment-649516204 {{{

command! -nargs=? DiffHistory call s:view_git_history(<q-args>)

function! s:view_git_history(...) abort
  0tabnew
  let fugitiveobj = '! !^@'
  if a:000[0] != ''
    let fugitiveobj = a:000[0]
  endif
  exe 'Git difftool --name-only' fugitiveobj
  call s:diff_current_quickfix_entry()
  " Bind <CR> for current quickfix window to properly set up diff split layout after selecting an item
  " There's probably a better way to map this without changing the window
  copen
  nnoremap <buffer> <CR> <CR><BAR>:call <sid>diff_current_quickfix_entry()<CR>
  wincmd p
  " Rotate diffs... the one on HEAD on the right
  " wincmd r
endfunction

function s:diff_current_quickfix_entry() abort
  " Cleanup windows
  for window in getwininfo()
    if window.winnr !=? winnr() && bufname(window.bufnr) =~? '^fugitive:'
      exe 'bdelete' window.bufnr
    endif
  endfor
  cc
  call s:add_mappings()
  let qf = getqflist({'context': 0, 'idx': 0})
  if get(qf, 'idx') && type(get(qf, 'context')) == type({}) && type(get(qf.context, 'items')) == type([])
    let diff = get(qf.context.items[qf.idx - 1], 'diff', [])
    " echom string(qf.context.items)
    " echom string(reverse(range(len(diff))))
    for i in reverse(range(len(diff)))
      exe (i ? 'leftabove' : 'rightbelow') 'vert diffsplit' fnameescape(diff[i].filename)
      call s:add_mappings()
    endfor
  endif
endfunction

function! s:add_mappings() abort
  nnoremap <buffer> <right> :cnext <BAR> :call <sid>diff_current_quickfix_entry()<CR>
  nnoremap <buffer> <left>  :cprevious <BAR> :call <sid>diff_current_quickfix_entry()<CR>
  " Reset quickfix height. Sometimes it messes up after selecting another item
  11copen
  wincmd p
  " Rotate diffs... the one on HEAD on the right
  " wincmd r
endfunction

