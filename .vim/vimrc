" Get current selection {{{

function! GetCurrentSelection(type) " {{{
    let reg_save = @@

    if a:type ==# 'v'
        silent execute "normal! `<" . a:type . "`>y"
    elseif a:type ==# 'V'
        silent execute "normal! `<" . a:type . "`>y"
    elseif a:type ==# 'char'
        silent execute "normal! `[v`]y"
    elseif a:type ==# 'line'
        silent execute "normal! `[V`]y"
    endif
    let selection = @@

    let @@ = reg_save

    return selection
endfunction " }}}

