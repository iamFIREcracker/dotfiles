    xmap <silent><buffer>   as   <Plug>(sexp_outer_string)
    omap <silent><buffer>   as   <Plug>(sexp_outer_string)
    xmap <silent><buffer>   is   <Plug>(sexp_inner_string)
    omap <silent><buffer>   is   <Plug>(sexp_inner_string)
    xmap <silent><buffer>   ae   <Plug>(sexp_outer_element)
    omap <silent><buffer>   ae   <Plug>(sexp_outer_element)
    xmap <silent><buffer>   ie   <Plug>(sexp_inner_element)
    omap <silent><buffer>   ie   <Plug>(sexp_inner_element)

    nmap <silent><buffer>   [[   <Plug>(sexp_move_to_prev_top_element)
    xmap <silent><buffer>   [[   <Plug>(sexp_move_to_prev_top_element)
    omap <silent><buffer>   [[   <Plug>(sexp_move_to_prev_top_element)
    nmap <silent><buffer>   ]]   <Plug>(sexp_move_to_next_top_element)
    xmap <silent><buffer>   ]]   <Plug>(sexp_move_to_next_top_element)
    omap <silent><buffer>   ]]   <Plug>(sexp_move_to_next_top_element)

    nmap <silent><buffer>   (    <Plug>(sexp_move_to_prev_bracket)
    xmap <silent><buffer>   (    <Plug>(sexp_outer_list)
    nmap <silent><buffer>   )    <Plug>(sexp_move_to_next_bracket)
    xmap <silent><buffer>   )    <Plug>(sexp_outer_list)

    " Easy getting around
    function! SidewaysOrUp(dir) abort "{{{
        let cursor = getcurpos()
        if a:dir == 'b'
            execute "normal \<Plug>(sexp_move_to_prev_element_head)"
        else
            call assert_true(a:dir == 'w')
            execute "normal \<Plug>(sexp_move_to_next_element_head)"
        endif

        let has_moved = cursor != getcurpos()
        if !has_moved
            if a:dir == 'b'
                execute "normal \<Plug>(sexp_move_to_prev_bracket)"
            else
                call assert_true(a:dir == 'w')
                execute "normal \<Plug>(sexp_move_to_next_bracket)"
            endif
        endif
    endfunction
    " }}}
    nmap <silent><buffer>   B       :call SidewaysOrUp('b')<CR>
    nmap <silent><buffer>   <M-b>   :call SidewaysOrUp('b')<CR>
    nmap <silent><buffer>   W       :call SidewaysOrUp('w')<CR>
    nmap <silent><buffer>   <M-f>   :call SidewaysOrUp('w')<CR>
    nmap <silent><buffer>   gE      <Plug>(sexp_move_to_prev_element_tail)
    nmap <silent><buffer>   E       <Plug>(sexp_move_to_next_element_tail)

    " Delete surrounding form
    " nmap <buffer> dsf <Plug>(sexp_splice_list)

    " Raise the current element or list
    nmap <silent><buffer> 'e <Plug>(sexp_raise_element)<C-Q>
    nmap <silent><buffer> 'f <Plug>(sexp_raise_list)<C-Q>

    " Wrap the current element or list
    function! WrapElemOrList(target) abort "{{{
        let view = winsaveview()
        let cursor = getpos('.')

        if a:target == 'e'
            execute "normal ysie)"
        elseif a:target == 'f'
            execute "normal ysif)"
        else
            call assert_true(a:target == 'F')
            execute "normal [[ysif)"
        endif

        call setpos('.', cursor)
        call winrestview(view)
    endfunction
    " }}}
    nmap <silent><buffer> _e :call WrapElemOrList('e')<CR>
    nmap <silent><buffer> _f :call WrapElemOrList('f')<CR>
    nmap <silent><buffer> _F :call WrapElemOrList('F')<CR>

    " Swap elements / forms
    "
    " angle bracket indicates the direction, and 'e' or 'f' indicates
    " if we are trying to swap an element or the surrounding form
    nmap <silent><buffer>   <e   <Plug>(sexp_swap_element_backward)<C-Q>
    nmap <silent><buffer>   <f   <Plug>(sexp_swap_list_backward)<C-Q>
    nmap <silent><buffer>   >e   <Plug>(sexp_swap_element_forward)<C-Q>
    nmap <silent><buffer>   >f   <Plug>(sexp_swap_list_forward)<C-Q>

    " Slurping/Barfing
    "
    " angle bracket indicates the direction, and the parenthesis
    " indicates which end to operate on.
    nmap <silent><buffer>   <(   <Plug>(sexp_capture_prev_element)<C-Q>
    nmap <silent><buffer>   >)   <Plug>(sexp_capture_next_element)<C-Q>
    nmap <silent><buffer>   >(   <Plug>(sexp_emit_head_element)<C-Q>
    nmap <silent><buffer>   <)   <Plug>(sexp_emit_tail_element)<C-Q>

    " Insert head/tail of the current list
    nmap <silent><bffer>   <I    <Plug>(sexp_insert_at_list_head)
    nmap <silent><buffer>   >I   <Plug>(sexp_insert_at_list_tail)

    " Comment out the current form / element
    function! ToggleCommonLispComment(toggle_form) abort "{{{
        if a:toggle_form ==# 'F'
            let motion = "\<Plug>(sexp_move_to_prev_top_element)"
            execute "normal " . motion
        else
            " Move at the start of the current element / form;
            " if on an open paren, or a quote symbol, or a string delimiter
            " already, do nothing
            " Note: it won't move even when on the closing delimiter of a string
            if stridx("(['\"", getline('.')[col('.') - 1]) == -1
                let motion = ""
                if a:toggle_form ==# 'f'
                    let motion = "\<Plug>(sexp_move_to_prev_bracket)"
                elseif a:toggle_form ==# 'e'
                    let motion = "\<Plug>(sexp_move_to_prev_element_head)"
                endif
                execute "normal " . motion
            endif
        endif

        " Figure out if we need to add a comment, or remove the existing one
        " Leave the cursor at the beginning of the element that
        " needs to be commented out or uncommented
        let should_add_comment = 1
        " Are we on a #+#: marker already?
        normal yW
        if @@ =~? "#+#:"
            let should_add_comment = 0
            normal W
        else
            " Move back to the previous element
            " Yank it
            " Check if it's a #+nil marker
            let save_cursor = getcurpos()
            let reg_save = @@
            execute "normal \<Plug>(sexp_move_to_prev_element_head)"
            normal yW
            if @@ =~? "#+#:"
                let should_add_comment = 0
            endif
            let @@ = reg_save
            call setpos('.', save_cursor)
        endif

        " Do the needed
        if should_add_comment
            " Insert the comment marker, and move back to the element / form
            execute "normal! i#+#:excluded "
            execute "normal \<Plug>(sexp_move_to_next_element_head)"
        else
            " Move back, and the delete forward
            execute "normal \<Plug>(sexp_move_to_prev_element_head)"
            normal dW
        endif
    endfunction
    " }}}
    nmap <silent><buffer>   gce  :call ToggleCommonLispComment('e')<CR><C-Q>
    nmap <silent><buffer>   gcf  :call ToggleCommonLispComment('f')<CR><C-Q>
    nmap <silent><buffer>   gcF  :call ToggleCommonLispComment('F')<CR><C-Q>

    " Operate on forms when editing code; by _line_ when on comments
    function! NormalOrComment(norm, comm) abort "{{{
        let stack = synstack(line('.'), col('.'))
        let inside_comment =
                    \ len(stack) && (synIDattr(get(stack, -1, ''), 'name') =~? 'comment')
        let inside_string =
                    \ len(stack) && (synIDattr(get(stack, -1, ''), 'name') =~? 'string')

        " XXX add support for "String" mappings, like D to delete until the end
        " of the current string
        if inside_comment || inside_string
            execute "normal!" a:norm
        else
            execute "normal" a:comm
        endif
    endfunction " }}}
    nmap <silent><buffer>   yy   :call NormalOrComment('yy', "yaf<C-O>")<CR>
    nmap <silent><buffer>    Y   :call NormalOrComment('y$', "y\<Plug>(sexp_move_to_next_bracket)")<CR>
    nmap <silent><buffer>   dd   :call NormalOrComment('dd', "daf")<CR>
    nmap <silent><buffer>    D   :call NormalOrComment('d$', "d\<Plug>(sexp_move_to_next_bracket)")<CR>
    nmap <silent><buffer>   cc   :call NormalOrComment('cc', "caf")<CR>a
    nmap <silent><buffer>    C   :call NormalOrComment('c$', "c\<Plug>(sexp_move_to_next_bracket)")<CR>a
    nmap <silent><buffer>   vv   :call NormalOrComment('vv', "vaf")<CR>
    nmap <silent><buffer>    I   :call NormalOrComment('I',  "\<Plug>(sexp_insert_at_list_head)")<CR>a
    nmap <silent><buffer>    A   :call NormalOrComment('A',  "\<Plug>(sexp_insert_at_list_tail)")<CR>a
endfunction " }}}

