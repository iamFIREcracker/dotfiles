function s:delimitMate_CtrlW() abort "{{{
    let ch = getline('.')[col('.') - 2] " 1, is for 0-index,
                                        " 1 because in insert mode we care
                                        " about the char _before_ the cursor
    let parens = get(b:, 'delimitMate_matchpairs', &matchpairs)
    let quotes = get(b:, 'delimitMate_quotes', "\" ' `")
    if stridx(parens . quotes, ch) >= 0
        return delimitMate#BS()
    else
        return ""
    endif
endfunction " }}}

" Command-line <C-W> like readline, with smart \v handling
cnoremap <expr> <C-W> CmdlineCtrlW()
function! CmdlineCtrlW() abort " {{{
  let line = getcmdline()
  let pos  = getcmdpos()      " 1-based: cursor is between chars pos-1 and pos

  " At very start: nothing to delete
  if pos <= 1
    return ''
  endif

  " By default we can delete all the way back to column 1
  let minpos = 1

  " Special handling for / and ? searches that start with literal "\v"
  " Note: getcmdline() for / and ? does *not* include the leading / or ?,
  " so the line starts directly with "\v..."
  if (getcmdtype() ==# '/' || getcmdtype() ==# '?')
        \ && len(line) >= 2
        \ && line[0] ==# '\'
        \ && line[1] ==# 'v'

    " Text after the "\v" (may be empty)
    let rest = len(line) > 2 ? line[2:] : ''

    " If there's any non-space after \v, keep \v on *this* <C-W>
    " (first delete stops at "\v")
    if rest =~# '^\s*\S'
      let minpos = 3          " 1-based: position right *after* "\v"
    endif
    " If only "\v" (and maybe spaces) remain, minpos stays 1,
    " so a further <C-W> can delete "\v" as well.
  endif

  " new_pos is the 1-based cursor position we want *after* deletion
  let new_pos = pos

  " 1) Skip whitespace to the left of the cursor
  " char left of position k is line[k-2] (0-based)
  while new_pos > minpos && line[new_pos - 2] =~# '\s'
    let new_pos -= 1
  endwhile

  " 2) Skip non-whitespace (the "word") to the left
  while new_pos > minpos && line[new_pos - 2] !~# '\s'
    let new_pos -= 1
  endwhile

  " Nothing to delete
  if new_pos == pos
    return ''
  endif

  " Number of chars to delete = distance from new_pos to pos
  let delcount = pos - new_pos

  " Let Vim do the actual deletion & cursor movement
  return repeat("\<BS>", delcount)
endfunction " }}}

