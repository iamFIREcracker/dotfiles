        let substitute_eol_with =
            \ get(b:, 'stt_substitute_eol_with',
                \ get(g:, 'stt_substitute_eol_with', '\n'))
        let keys = substitute(keys, '\n', substitute_eol_with, 'g')

        call term_sendkeys(w:stt_buffnr, keys)
    endif
endfunction " }}}

