vnoremap <space> za

function! MyFoldText() " {{{
    let line = getline(v:foldstart)

    let nucolwidth = &fdc + &number * &numberwidth
    let windowwidth = winwidth(0) - nucolwidth - 1 " one blank space after the fold size
    let foldedlinecount = v:foldend - v:foldstart
    let foldedlinecountstring = ' · ' . foldedlinecount . ' '

    " expand tabs into spaces
    let onetab = strpart('          ', 0, &tabstop)
    let line = substitute(line, '\t', onetab, 'g')

    let line = strpart(line, 0, windowwidth - len(foldedlinecountstring))
    let fillcharcount = windowwidth - len(line) - len(foldedlinecountstring)
    return line . ' ' . repeat(" ",fillcharcount) . ' ' . foldedlinecountstring
endfunction " }}}
set foldtext=MyFoldText()

