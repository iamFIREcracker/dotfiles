" Mute theme on focus lost {{{

augroup mute_theme_on_focus_lost
    au!

    let g:old_cursor_line_nr_hi = ''
    let g:old_tab_line_sel_hi = ''

    function! MuteCursorLineNr()
        let old_hi = execute('hi CursorLineNr')
        let old_hi = split(old_hi, '\n')[0]
        let g:old_cursor_line_nr_hi = substitute(old_hi, 'xxx', '', '')

        hi! link CursorLineNr LineNr
    endfunction

    function! UnmuteCursorLineNr()
        if g:old_cursor_line_nr_hi == ''
            return
        endif
        " `execute hi ...` would not output any property explicitly set to NONE
        " so if the theme's CursorLineNr does not explicitly set `ctermbg`,
        " whichever the last value we set here, will persist after this function
        " runs
        hi CursorLineNr ctermbg=NONE ctermfg=NONE cterm=NONE guibg=NONE guifg=NONE gui=NONE

        execute 'hi! ' . g:old_cursor_line_nr_hi
        let g:old_cursor_line_nr_hi = ''
    endfunction

    function! MuteTabLineSel()
        let old_hi = execute('hi TabLineSel')
        let old_hi = split(old_hi, '\n')[0]
        let g:tab_line_sel_hi = substitute(old_hi, 'xxx', '', '')

        hi! link TabLineSel LineNr
        redraw
    endfunction

    function! UnmuteTabLineSel()
        if g:tab_line_sel_hi == ''
            return
        endif
        " `execute hi ...` would not output any property explicitly set to NONE
        " so if the theme's TabLineSel does not explicitly set `ctermbg`,
        " whichever the last value we set here, will persist after this function
        " runs
        hi TabLineSel ctermbg=NONE ctermfg=NONE cterm=NONE guibg=NONE guifg=NONE gui=NONE

        execute 'hi! ' . g:tab_line_sel_hi
        let g:tab_line_sel_hi = ''
    endfunction

    au FocusLost              * :call MuteCursorLineNr()
    au FocusLost              * :call MuteTabLineSel()
    au FocusGained            * :call UnmuteCursorLineNr()
    au FocusGained            * :call UnmuteTabLineSel()

    au VimEnter               * set colorcolumn=+1 cursorline
    au WinLeave,BufWinLeave   * let b:old_colorcolumn = &colorcolumn | set colorcolumn= nocursorline
    au WinEnter,BufWinEnter   * if exists('b:old_colorcolumn') | let &l:colorcolumn=b:old_colorcolumn | unlet b:old_colorcolumn | endif | setl cursorline
augroup END
